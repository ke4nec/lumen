// Counter UI (plan §6.2). Loaded by `lumen-counter --dsl`; the integration
// test asserts it matches the C++ builder tree field for field.
// Controls carry no explicit styles: Button/TextField/Text resolve their
// chrome and typography from the shell Theme (visual system §5/§6). The
// container color mirrors theme.colors.pageBackground (dark #18181B).
// The window title bar (custom chrome with minimize/maximize/close) is
// composed app-side by CounterApp — the frozen DSL has no windowDrag/icon,
// so the golden tree stays content-only.
page Counter {
  Container(key: "root", color: #18181B) {
    Column(padding: 24, spacing: 12) {
      Text("Count: ", bind: counter, key: "count-text")
      Button("Increment", onClick: increment, key: "increment-button")
      TextField(bind: name, placeholder: "Name", key: "name-field")
    }
  }
}
